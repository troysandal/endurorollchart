{
  "name": "hosting",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run firebase",
    "build": "tsc && vite build --mode development",
    "deploy:firestore": "firebase deploy --only firestore",
    "deploy:hosting": "firebase deploy --only hosting",
    "preview": "vite preview",
    "firebase": "rm -rf ../.firebase/*/hosting && FIREBASE_FRAMEWORKS_BUILD_TARGET='development' firebase emulators:start --only auth,firestore,hosting --import=./offline-seed --export-on-exit",
    "test": "npm run test:unit && npm run test:rules && npm run test:e2e",
    "test:e2e": "cypress run --browser chrome",
    "test:rules": "mocha --config .mocharc.rules.cjs",
    "test:unit": "mocha",
    "test:debug": "mocha --inspect"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/jquery": "^4.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@vituum/vite-plugin-handlebars": "^2.0.2",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "cypress": "^16.3.0",
    "cypress-firebase": "^4.6.0",
    "firebase-admin": "^14.5.0",
    "mocha": "^12.0.3",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vituum": "^2.0.2"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "firebase-tools": "^15.35.0"
  },
  "engines": {
    "node": ">=24.12 <25"
  }
}
