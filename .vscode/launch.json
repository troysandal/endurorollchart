{
  "configurations": [
    {
      "name": "Launch Chrome",
      "request": "launch",
      "type": "chrome",
      "url": "http://localhost:5000",
      "webRoot": "${workspaceFolder}/web/src"
    },
    {
      "name": "Debug Current File",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "request": "launch",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "node"
    },
    {
      "name": "Debug Mocha",
      "cwd": "${workspaceFolder}/web",
      "request": "launch",
      "runtimeArgs": [
          "mocha",
          "--inspect"
      ],
      "runtimeExecutable": "npx",
      "skipFiles": [
          "<node_internals>/**"
      ],
      "type": "node"
  },
  ]
}